# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real secrets.

# From manage.sanity.io after you run `npx sanity init` (see README.md)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Safe to leave as-is
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# A token with "Editor" permissions, created at
# manage.sanity.io -> your project -> API -> Tokens
# Required for the contact form to save messages into Sanity.
SANITY_API_WRITE_TOKEN=

# Optional: enables Draft Mode so you can preview unpublished edits before
# hitting Publish. Both are required together, or leave both blank to skip
# this feature entirely - nothing else on the site depends on it.
#   SANITY_API_READ_TOKEN: a token with "Viewer" permissions (same Tokens
#     page as above).
#   NEXT_PUBLIC_SANITY_PREVIEW_SECRET: any random string you make up
#     yourself, e.g. `openssl rand -hex 16`. Not a Sanity credential.
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_SANITY_PREVIEW_SECRET=

# Your deployed URL (used for the sitemap + SEO tags). Leave as localhost
# for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
